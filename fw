local function createWingPanel(tab)
    local panel = new("CanvasGroup", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -40, 0.5, 0),
        Size = UDim2.fromOffset(310, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = C.Bg1, BorderSizePixel = 0, ZIndex = 20, Visible = false, GroupTransparency = 1,
    }, gui)
    round(panel, 14)
    stroke(panel, C.Ice, 1.5, 0.25)
    local pscale = new("UIScale", { Scale = 0.92 }, panel)
    vlist(panel, 0)

    local head = new("Frame", {
        Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = C.Card, BackgroundTransparency = 0.3,
        BorderSizePixel = 0, LayoutOrder = 1, Active = true,
    }, panel)
    text(head, {
        Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -60, 1, 0), Font = F_BOLD, TextSize = 13,
        TextColor3 = C.Frost, TextXAlignment = Enum.TextXAlignment.Left, Text = "WING  COLOR",
    })
    local closeB = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(24, 24),
        BackgroundTransparency = 1, Text = "×", Font = F_BOLD, TextSize = 18, TextColor3 = C.Mute,
    }, head)
    closeB.MouseEnter:Connect(function() tween(closeB, 0.12, { TextColor3 = C.Frost }) end)
    closeB.MouseLeave:Connect(function() tween(closeB, 0.12, { TextColor3 = C.Mute }) end)

    local bodyCol = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2,
    }, panel)
    pad(bodyCol, 10, 10, 12, 10)
    vlist(bodyCol, 10)

    local preview = new("Frame", {
        Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = Color3.fromRGB(Cfg.WingColor[1], Cfg.WingColor[2], Cfg.WingColor[3]),
        BorderSizePixel = 0, LayoutOrder = 1,
    }, bodyCol)
    round(preview, 8)
    stroke(preview, C.Frost, 1, 0.5)

    local function curColor()
        return Color3.fromRGB(Cfg.WingColor[1], Cfg.WingColor[2], Cfg.WingColor[3])
    end
    local function updatePreview(hue)
        if Cfg.WingRainbow then
            preview.BackgroundColor3 = Color3.fromHSV((hue or wingHue) % 1, 0.75, 1)
        else
            preview.BackgroundColor3 = curColor()
        end
    end
    wingPreviewHook = updatePreview

    local function colorChanged()
        updatePreview()
        applyWingColor()
        touch()
    end

    local sec = tab:AddSection("Color", bodyCol)
    local presets = {
        Color3.fromRGB(133, 220, 255), Color3.fromRGB(255, 213, 100), Color3.fromRGB(255, 120, 200),
        Color3.fromRGB(170, 110, 255), Color3.fromRGB(255, 80, 90), Color3.fromRGB(110, 255, 150),
        Color3.fromRGB(255, 255, 255),
    }
    local function setRGB(r, g, b, fromSliders)
        Cfg.WingColor = { r, g, b }
        if not fromSliders then
            UI.wingR:Set(r); UI.wingG:Set(g); UI.wingB:Set(b)
        end
        colorChanged()
    end
    sec:AddSwatches("Presets", presets, 0, function(col)
        setRGB(math.floor(col.R * 255 + 0.5), math.floor(col.G * 255 + 0.5), math.floor(col.B * 255 + 0.5), false)
    end)
    UI.wingR = sec:AddSlider("Red", 0, 255, Cfg.WingColor[1], function(v)
        Cfg.WingColor = { v, Cfg.WingColor[2], Cfg.WingColor[3] }; colorChanged()
    end)
    UI.wingG = sec:AddSlider("Green", 0, 255, Cfg.WingColor[2], function(v)
        Cfg.WingColor = { Cfg.WingColor[1], v, Cfg.WingColor[3] }; colorChanged()
    end)
    UI.wingB = sec:AddSlider("Blue", 0, 255, Cfg.WingColor[3], function(v)
        Cfg.WingColor = { Cfg.WingColor[1], Cfg.WingColor[2], v }; colorChanged()
    end)

    local rb = tab:AddSection("Rainbow", bodyCol)
    UI.wingRainbow = rb:AddToggle("Rainbow", Cfg.WingRainbow, function(v)
        Cfg.WingRainbow = v
        colorChanged()
    end)
    UI.wingSpeed = rb:AddSlider("Rainbow Speed", 0.1, 3, Cfg.WingSpeed, function(v)
        Cfg.WingSpeed = v; touch()
    end, { Decimals = 1, Suffix = "x" })
    rb:AddButton("Reset Color", function()
        Cfg.WingRainbow = false
        UI.wingRainbow:Set(false)
        setRGB(133, 220, 255, false)
    end)

    -- 開閉
    local api = {}
    local isOpen = false
    function api.set(v)
        isOpen = v
        if v then
            panel.Visible = true
            updatePreview()
            tween(panel, 0.35, { GroupTransparency = 0 })
            tween(pscale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
        else
            tween(panel, 0.25, { GroupTransparency = 1 })
            tween(pscale, 0.25, { Scale = 0.92 })
            task.delay(0.27, function() if not isOpen then panel.Visible = false end end)
        end
    end
    function api.toggle() api.set(not isOpen) end
    function api.sync() updatePreview() end
    closeB.MouseButton1Click:Connect(function() api.set(false) end)

    -- ヘッダーをドラッグして移動
    local dragging, dStart, pStart = false, nil, nil
    head.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dStart = Vector2.new(i.Position.X, i.Position.Y)
            pStart = panel.Position
        end
    end)
    conn(UserInputService.InputChanged, function(i)
        if not dragging then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
            local d = Vector2.new(i.Position.X, i.Position.Y) - dStart
            panel.Position = UDim2.new(pStart.X.Scale, pStart.X.Offset + d.X, pStart.Y.Scale, pStart.Y.Offset + d.Y)
        end
    end)
    conn(UserInputService.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    -- メインUIを閉じたらパネルも閉じる
    conn(RunService.Heartbeat, function()
        if isOpen and not Win.Visible then api.set(false) end
    end)
    return api
end

