local Lighting = game:GetService("Lighting")
local SKY_COLORS = {
    ["Gray Sky"]       = Color3.fromRGB(150, 150, 156),
    ["Light Gray Sky"] = Color3.fromRGB(205, 205, 210),
    ["Dark Gray Sky"]  = Color3.fromRGB(78, 78, 84),
}
local skyOrig = {}
local ownAtmo = nil

local function remember(inst, props)
    if skyOrig[inst] then return end
    local t = {}
    for _, p in ipairs(props) do t[p] = inst[p] end
    skyOrig[inst] = t
end
local function skyRestore()
    for inst, t in pairs(skyOrig) do
        if inst.Parent then
            for p, v in pairs(t) do pcall(function() inst[p] = v end) end
        end
    end
    table.clear(skyOrig)
    if ownAtmo then pcall(function() ownAtmo:Destroy() end); ownAtmo = nil end
end
local function skyEnforce()
    local col = SKY_COLORS[Cfg.SkyStyle] or SKY_COLORS["Gray Sky"]
    local gameAtmo
    for _, c in ipairs(Lighting:GetChildren()) do
        if c:IsA("Atmosphere") and c ~= ownAtmo then gameAtmo = c; break end
    end
    local atmo
    if gameAtmo then
        if ownAtmo then ownAtmo:Destroy(); ownAtmo = nil end
        atmo = gameAtmo
        remember(atmo, { "Color", "Decay", "Density", "Offset", "Glare", "Haze" })
    else
        if not ownAtmo or not ownAtmo.Parent then
            ownAtmo = Instance.new("Atmosphere")
            ownAtmo.Name = "FW_GraySkyAtmosphere"
            ownAtmo.Parent = Lighting
        end
        atmo = ownAtmo
    end
    -- Offset=1 でスカイボックスを隠し、霞の色で空を塗りつぶす
    if atmo.Color ~= col then atmo.Color = col end
    if atmo.Decay ~= col then atmo.Decay = col end
    if atmo.Offset ~= 1 then atmo.Offset = 1 end
    if atmo.Glare ~= 0 then atmo.Glare = 0 end
    if atmo.Haze ~= 0 then atmo.Haze = 0 end
    if atmo.Density < 0.3 then atmo.Density = 0.3 end
    -- 太陽・月・星も非表示
    for _, c in ipairs(Lighting:GetChildren()) do
        if c:IsA("Sky") then
            remember(c, { "CelestialBodiesShown", "StarCount" })
            if c.CelestialBodiesShown then c.CelestialBodiesShown = false end
            if c.StarCount ~= 0 then c.StarCount = 0 end
        end
    end
end
local function applySky()
    if Cfg.SkyOn then pcall(skyEnforce) else skyRestore() end
end
task.spawn(function()
    while Lib.Alive do
        task.wait(1.5)
        if Cfg.SkyOn then pcall(skyEnforce) end
    end
end)

