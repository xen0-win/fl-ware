            tween(shell, 0.4, {
                Size = UDim2.fromOffset(W, H),
                Position = UDim2.new(pp.X.Scale, pp.X.Offset + (W - oldW) / 2, pp.Y.Scale, pp.Y.Offset + (H - oldH) / 2),
