    local t, frames, acc = 0, 0, 0
    conn(RunService.Heartbeat, function(dt)
        t = t + dt
        frames = frames + 1
        acc = acc + dt
        if acc >= 0.5 then
            fpsLbl.Text = math.floor(frames / acc + 0.5) .. " FPS"
            frames, acc = 0, 0
        end
        if not Window.Visible then return end
        edgeGrad.Rotation = (t * 45) % 360
        updateFlake3D(t)
        logo.Rotation = (t * 18) % 360
        bandGrad.Offset = Vector2.new(math.sin(t * 0.35) * 0.55, 0)
        if Window.Snow.On then
            local sp = Window.Snow.Speed
            for i = 1, Window.Snow.Count do
                local fl = flakes[i]
                if fl then
                    fl.y = fl.y + fl.spd * sp * dt
                    if fl.y > H + 6 then fl.y = -6 end
                    local x = fl.bx * (W / 700) + math.sin(t * fl.sway + fl.ph) * fl.amp
                    fl.f.Position = UDim2.fromOffset(x, fl.y)
                end
            end
        end
    end)

