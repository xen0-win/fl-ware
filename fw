local THEME_KEYS = { "Bg0", "Bg1", "Card", "Card2", "Line", "Ice", "Ice2", "Frost", "Mute", "Text" }
local function ckey(c)
    return string.format("%d,%d,%d", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end
local function recolorInst(o, map)
    local function fix(prop)
        local n = map[ckey(o[prop])]
        if n then o[prop] = n end
    end
    if o:IsA("GuiObject") then
        fix("BackgroundColor3")
        if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
            fix("TextColor3")
            if o:IsA("TextBox") then fix("PlaceholderColor3") end
        end
        if o:IsA("ImageLabel") or o:IsA("ImageButton") or o:IsA("ViewportFrame") then fix("ImageColor3") end
        if o:IsA("ScrollingFrame") then fix("ScrollBarImageColor3") end
    elseif o:IsA("UIStroke") then
        fix("Color")
    elseif o:IsA("UIGradient") then
        local changed, kps = false, {}
        for i, kp in ipairs(o.Color.Keypoints) do
            local n = map[ckey(kp.Value)]
            if n then changed = true end
            kps[i] = ColorSequenceKeypoint.new(kp.Time, n or kp.Value)
        end
        if changed then o.Color = ColorSequence.new(kps) end
    elseif o:IsA("BasePart") then
        fix("Color")
    end
end

function Lib:SetTheme(name)
    local th = Lib.Themes[name]
    if not th then return false end
    local map = {}
    local same = (Lib.Theme == name)
    if not same then
        for _, k in ipairs(THEME_KEYS) do map[ckey(C[k])] = th.Colors[k] end
        for _, k in ipairs(THEME_KEYS) do C[k] = th.Colors[k] end
        ICE_SEQ = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   C.Ice2),
            ColorSequenceKeypoint.new(0.5, C.Ice),
            ColorSequenceKeypoint.new(1,   C.Frost),
        })
        for _, root in ipairs({ gui, cursorGui }) do
            pcall(recolorInst, root, map)
            for _, d in ipairs(root:GetDescendants()) do pcall(recolorInst, d, map) end
        end
    end
    Lib.Theme = name
    if Lib.OnTheme then Lib.OnTheme(name, th) end
    return true
end

function Lib:Unload()
    Lib.Alive = false
    for _, f in ipairs(Lib.Cleanups) do pcall(f) end
    for _, c in ipairs(Lib.Connections) do pcall(function() c:Disconnect() end) end
    table.clear(Lib.Connections)
    pcall(function()
        for _, n in ipairs({ "FW_CC", "FW_Blur", "FW_Bloom", "FW_MenuBlur" }) do
