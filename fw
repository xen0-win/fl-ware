local function sanitize(name)
    name = tostring(name or "")
    name = name:gsub("[/\\:*?\"<>|]", "_")
    name = name:gsub("^%s+", ""):gsub("%s+$", "")
    return name:sub(1, 40)
end
local function cfgPath(name) return CONFIG_DIR .. "/" .. name .. ".json" end

local function listConfigs()
    local list = {}
    pcall(function()
        if listfiles and isfolder and isfolder(CONFIG_DIR) then
            for _, f in ipairs(listfiles(CONFIG_DIR)) do
                local n = tostring(f):match("([^/\\]+)%.json$")
                if n then list[#list + 1] = n end
            end
        end
    end)
    table.sort(list)
    return list
end

local function refreshList(select)
    local list = listConfigs()
    if #list == 0 then list = { "(empty)" } end
    UI.cfgList:SetOptions(list)
    local pick = list[1]
    for _, n in ipairs(list) do if n == select then pick = n end end
    UI.cfgList:Set(pick)
end

local function setLoaded(name)
    CF.loadedName = name
    UI.loadedLbl.Text = "Config:  " .. (name or "(none)")
end

local function needFS()
    if fsOK then return true end
    Lib:Notify("Config", "この環境はファイル保存に対応していません。", 4)
    return false
end

CF.create = function()
    if not needFS() then return end
    local name = sanitize(UI.cfgName.Text)
    if name == "" then Lib:Notify("Config", "コンフィグ名を入力してください。", 3); return end
    if jsonWrite(cfgPath(name), snapshot()) then
        refreshList(name)
        setLoaded(name)
        Lib:Notify("Config", "「" .. name .. "」を作成しました。", 3)
    else
        Lib:Notify("Config", "保存に失敗しました。", 3)
    end
end
CF.load = function()
    if not needFS() then return end
    local name = UI.cfgList:Get()
    if not name or name == "(empty)" then Lib:Notify("Config", "読み込むコンフィグがありません。", 3); return end
    local data = jsonRead(cfgPath(name))
    if not data then Lib:Notify("Config", "読み込みに失敗しました。", 3); return end
    applyData(data)
    applyAll()
    syncUI()
    setLoaded(name)
    touch()
    Lib:Notify("Config", "「" .. name .. "」を読み込みました。", 3)
end
CF.overwrite = function()
    if not needFS() then return end
    local name = sanitize(UI.cfgName.Text)
    if name == "" then name = UI.cfgList:Get() end
    if not name or name == "" or name == "(empty)" then Lib:Notify("Config", "上書き先がありません。", 3); return end
    if jsonWrite(cfgPath(name), snapshot()) then
        refreshList(name)
        setLoaded(name)
        Lib:Notify("Config", "「" .. name .. "」を上書きしました。", 3)
    else
        Lib:Notify("Config", "保存に失敗しました。", 3)
    end
end
CF.delete = function()
    if not needFS() then return end
    local name = UI.cfgList:Get()
    if not name or name == "(empty)" then return end
    local ok = pcall(function() delfile(cfgPath(name)) end)
    if ok then
        refreshList()
        if CF.loadedName == name then setLoaded(nil) end
        Lib:Notify("Config", "「" .. name .. "」を削除しました。", 3)
    else
        Lib:Notify("Config", "削除に失敗しました。", 3)
    end
end

-- 自動保存 (変更があれば2秒おき)
task.spawn(function()
    while Lib.Alive do
        task.wait(2)
        if CF.dirty then
            CF.dirty = false
            saveLast()
        end
    end
end)

-- 起動時: 前回の状態を復元
do
    local last = jsonRead(LAST_FILE)
    if last then
        if last.AutoLoad == false then
            Cfg.AutoLoad = false
        else
            applyData(last)
        end
    end
    applyAll()
    syncUI()
    refreshList()
end
task.delay(0.6, function()
    if Cfg.LoadSoundEnabled then playOnce(Cfg.LoadSoundId, Cfg.LoadSoundVolume) end
end)

table.insert(Lib.Cleanups, function()
    saveLast()
    Cfg.HitEnabled, Cfg.KillEnabled = false, false
    refreshSwaps()
    setNoTextures(false)
    setPack(false)
    pcall(function() testSound:Destroy() end)
    Cfg.SkyOn = false
    pcall(skyRestore)
    pcall(setWing, false)
end)

