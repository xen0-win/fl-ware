local WING_TREE = { name = "angel", nodes = WING_NODES, links = WING_LINKS }

-- ---------- ON/OFF・色・レインボー ----------
local wingLoaded, wingToken, wingConn = false, 0, nil
local wingHue, wingTick = 0, 0
local wingPreviewHook = nil

local function wingSequence(hue)
    if Cfg.WingRainbow then
        local kps = {}
        for k = 0, 4 do
            kps[#kps + 1] = ColorSequenceKeypoint.new(k / 4, Color3.fromHSV((hue + k * 0.12) % 1, 0.75, 1))
        end
        return ColorSequence.new(kps)
    end
    local c = Cfg.WingColor
    return ColorSequence.new(Color3.fromRGB(c[1], c[2], c[3]))
end
local function applyWingColor(hue)
    if not wingLoaded then return end
    local seq = wingSequence(hue or wingHue)
    for _, inst in ipairs(AuraEngine.GetInstances()) do
        if inst:IsA("ParticleEmitter") or inst:IsA("Beam") then
            pcall(function() inst.Color = seq end)
        end
    end
end
local function wingLoad(character)
    wingToken = wingToken + 1
    local my = wingToken
    task.spawn(function()
        if not character then return end
        character:WaitForChild("HumanoidRootPart", 10)
        task.wait(0.25)
        if my ~= wingToken or not Cfg.WingOn then return end
        local ok, res = pcall(AuraEngine.Load, WING_TREE, character)
        wingLoaded = (ok and res == true)
        if wingLoaded then applyWingColor() end
    end)
end
local function setWing(on)
    on = on == true
    Cfg.WingOn = on
    if wingConn then wingConn:Disconnect(); wingConn = nil end
    wingToken = wingToken + 1
    if on then
        local plr = Players.LocalPlayer
        if plr then
            if plr.Character then wingLoad(plr.Character) end
            wingConn = plr.CharacterAdded:Connect(wingLoad)
        end
    else
        wingLoaded = false
        AuraEngine.Unload()
    end
end
conn(RunService.Heartbeat, function(dt)
    if not Cfg.WingRainbow then return end
    wingHue = (wingHue + dt * 0.15 * Cfg.WingSpeed) % 1
    wingTick = wingTick + dt
    if wingTick >= 0.05 then
        wingTick = 0
        applyWingColor(wingHue)
        if wingPreviewHook then wingPreviewHook(wingHue) end
    end
end)

