            -- ---------- Dropdown (インライン展開) ----------
            function Section:AddDropdown(label, options, default, callback)
                local HEAD, OPT = 34, 24
                local selected = default or options[1]
                local open = false

                local box = new("Frame", {
                    Size = UDim2.new(1, 0, 0, HEAD), BackgroundColor3 = C.Card2, BackgroundTransparency = 0.2,
                    ClipsDescendants = true, LayoutOrder = nextOrder(),
                }, inner)
                round(box, 8)
                local st = stroke(box, C.Line, 1, 0.4)
                local headBtn = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, HEAD), BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
                }, box)
                text(headBtn, {
                    Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.5, -12, 1, 0),
                    TextColor3 = C.Mute, TextXAlignment = Enum.TextXAlignment.Left, Text = label,
                })
                local valLbl = text(headBtn, {
                    Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0.5, -32, 1, 0), Font = F_BOLD,
                    TextColor3 = C.Frost, TextXAlignment = Enum.TextXAlignment.Right, Text = tostring(selected),
                })
                local arrow = text(headBtn, {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.fromOffset(14, 14), Font = F_BOLD, TextSize = 9, TextColor3 = C.Ice, Text = "▼",
                })

                local list = new("Frame", {
                    Position = UDim2.fromOffset(0, HEAD), Size = UDim2.new(1, 0, 0, #options * OPT + 4),
                    BackgroundTransparency = 1,
                }, box)
                pad(list, 0, 6, 4, 6)
                vlist(list, 0)

                local optButtons = {}
                local function paint()
                    for opt, b in pairs(optButtons) do
                        b.TextColor3 = (opt == selected) and C.Ice or C.Text
                        b.Font = (opt == selected) and F_BOLD or F_REG
                    end
                    valLbl.Text = tostring(selected)
                end
                local function build()
                    for _, b in pairs(optButtons) do b:Destroy() end
                    optButtons = {}
                    list.Size = UDim2.new(1, 0, 0, #options * OPT + 4)
                    for i, opt in ipairs(options) do
                        local b = new("TextButton", {
                            Size = UDim2.new(1, 0, 0, OPT), BackgroundTransparency = 1, Text = tostring(opt),
                            Font = F_REG, TextSize = 12, TextColor3 = C.Text, AutoButtonColor = false, LayoutOrder = i,
                        }, list)
                        optButtons[opt] = b
                        b.MouseEnter:Connect(function() if opt ~= selected then tween(b, 0.1, { TextColor3 = C.Frost }) end end)
                        b.MouseLeave:Connect(function() if opt ~= selected then tween(b, 0.1, { TextColor3 = C.Text }) end end)
                        b.MouseButton1Click:Connect(function()
                            selected = opt
                            paint()
                            open = false
                            tween(box, 0.3, { Size = UDim2.new(1, 0, 0, HEAD) })
                            tween(arrow, 0.3, { Rotation = 0 })
                            tween(st, 0.3, { Color = C.Line })
                            if callback then task.spawn(callback, opt) end
                        end)
                    end
                    paint()
                    if open then box.Size = UDim2.new(1, 0, 0, HEAD + #options * OPT + 4) end
                end
                build()

                headBtn.MouseButton1Click:Connect(function()
                    open = not open
                    tween(box, 0.35, { Size = UDim2.new(1, 0, 0, open and (HEAD + #options * OPT + 4) or HEAD) }, Enum.EasingStyle.Quint)
                    tween(arrow, 0.3, { Rotation = open and 180 or 0 })
                    tween(st, 0.3, { Color = open and C.Ice or C.Line })
                end)

                return {
                    Frame = box,
                    Set = function(_, v) selected = v; paint() end,
                    Get = function() return selected end,
                    SetOptions = function(_, opts) options = opts; build() end,
                }
            end

