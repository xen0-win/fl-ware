-- WINDOW
-- =========================================================
function Lib:CreateWindow(cfg)
    cfg = cfg or {}
    local W, H = 700, 450
    local MIN_W, MIN_H = 560, 380
    local LAYOUT_FILE = "frozenware_layout.json"
    local savedPos = nil
    pcall(function()
        if isfile and isfile(LAYOUT_FILE) then
            local d = game:GetService("HttpService"):JSONDecode(readfile(LAYOUT_FILE))
            if type(d) == "table" then
                W = math.clamp(tonumber(d.w) or W, MIN_W, 1400)
                H = math.clamp(tonumber(d.h) or H, MIN_H, 1000)
                if d.xs and d.xo and d.ys and d.yo then
                    savedPos = UDim2.new(tonumber(d.xs), tonumber(d.xo), tonumber(d.ys), tonumber(d.yo))
                end
            end
        end
    end)
    local HEADER_H, FOOTER_H, RAIL_W = 52, 24, 78
    local Window = { Tabs = {}, Visible = false, Snow = { On = true, Count = 34, Speed = 1 }, Flake = { On = true, Scale = 0.55 } }

    -- ---------- 画面中央の3Dネオン結晶 + 背景ぼかし ----------
    local flakeVF = new("ViewportFrame", {
        Name = "NeonFlakeView", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(900, 900), BackgroundTransparency = 1, ImageTransparency = 1,
        Ambient = Color3.new(1, 1, 1), LightColor = Color3.new(1, 1, 1), Visible = false,
    }, gui)
    local vcam = Instance.new("Camera")
    vcam.FieldOfView = 45
    vcam.CFrame = CFrame.lookAt(Vector3.new(0, 0, 24), Vector3.new())
    vcam.Parent = flakeVF
    flakeVF.CurrentCamera = vcam
    local flakeModel, flakePulsers = buildFlake3D(flakeVF)

    local menuBlur
    pcall(function()
        menuBlur = new("BlurEffect", { Name = "FW_MenuBlur", Size = 0 }, game:GetService("Lighting"))
    end)

    local function refreshFlakeView()
        local vp = gui.AbsoluteSize
        local sz = math.max(180, math.min(vp.X, vp.Y) * Window.Flake.Scale)
        flakeVF.Size = UDim2.fromOffset(sz, sz)
        if Window.Visible and Window.Flake.On then
            flakeVF.Visible = true
            tween(flakeVF, 0.5, { ImageTransparency = 0 })
        else
            tween(flakeVF, 0.35, { ImageTransparency = 1 })
            task.delay(0.4, function()
                if not (Window.Visible and Window.Flake.On) then flakeVF.Visible = false end
            end)
        end
    end
    local function showFX(v)
        refreshFlakeView()
        if menuBlur then tween(menuBlur, v and 0.5 or 0.35, { Size = v and 18 or 0 }) end
    end
    function Window:SetFlake3D(on)
        self.Flake.On = on == true
        refreshFlakeView()
    end
    function Window:SetFlakeScale(f)
        self.Flake.Scale = math.clamp(tonumber(f) or 0.55, 0.15, 1.3)
        if self.Flake.On then refreshFlakeView() end
    end
    local function updateFlake3D(t)
        if not Window.Flake.On then return end
        flakeModel:PivotTo(CFrame.Angles(math.sin(t * 0.4) * 0.55, t * 0.7, t * 0.18))
        local pulse = math.sin(t * 2.2) * 0.08
        for _, pl in ipairs(flakePulsers) do
            pl.part.Transparency = math.clamp(pl.base + pulse, 0, 1)
        end
    end

    -- ---------- Shell / Body ----------
    local shell = new("Frame", {
        Name = "Shell", AnchorPoint = Vector2.new(0.5, 0.5),
        Position = savedPos or UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(W, H),
        BackgroundTransparency = 1, Visible = false,
    }, gui)
    round(shell, 16)
    local scale = new("UIScale", { Scale = 0.92 }, shell)

    local glow = new("Frame", {
        Position = UDim2.fromOffset(-7, -7), Size = UDim2.new(1, 14, 1, 14), BackgroundTransparency = 1,
    }, shell)
    round(glow, 22)
    stroke(glow, C.Ice, 7, 0.9)

    local edge = stroke(shell, C.Ice, 1.6, 1)
    local edgeGrad = grad(edge, ColorSequence.new({
        ColorSequenceKeypoint.new(0,    C.Ice2),
        ColorSequenceKeypoint.new(0.35, C.Frost),
        ColorSequenceKeypoint.new(0.65, C.Ice),
        ColorSequenceKeypoint.new(1,    C.Ice2),
    }), 0, NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.5, 0.75),
        NumberSequenceKeypoint.new(1, 0),
    }))

    local body = new("CanvasGroup", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Bg0,
        BorderSizePixel = 0, GroupTransparency = 1,
    }, shell)
    round(body, 16)
    -- 背景グラデーションは専用フレームに付ける (CanvasGroup自体に付けると中身全体が色被りする)
    local bgFrame = new("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Bg1, BorderSizePixel = 0,
    }, body)
    grad(bgFrame, ColorSequence.new(C.Bg1, C.Bg0), 90)

    -- 明るさ調整用のベール (既定ではほぼ透明)
    local veil = new("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Frost,
        BackgroundTransparency = 0.95, BorderSizePixel = 0,
    }, body)
    function Window:SetBrightness(a)
        a = math.clamp(a or 0.5, 0, 1)
        veil.BackgroundTransparency = 0.95 - a * 0.6
    end

    local modal = new("TextButton", {
        Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, Text = "", Modal = false,
    }, shell)

    -- ---------- オーロラ ----------
    local aurora = new("Frame", {
        Size = UDim2.new(1, 0, 0, 170), BackgroundColor3 = C.Ice2, BorderSizePixel = 0,
    }, body)
    grad(aurora, ColorSequence.new(C.Ice2, C.Ice), 90, NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1),
    }))
    local bandFrame = new("Frame", {
        Size = UDim2.new(1, 0, 0, 120), BackgroundColor3 = C.Ice, BorderSizePixel = 0,
    }, body)
    local bandGrad = grad(bandFrame, ICE_SEQ, 0, NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.68), NumberSequenceKeypoint.new(1, 1),
    }))

    -- ---------- 雪 ----------
    local snowLayer = new("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 1,
    }, body)
    local rng = Random.new(42)
    local flakes = {}
    for i = 1, 60 do
        local s = rng:NextInteger(2, 5)
        local f = new("Frame", {
            Size = UDim2.fromOffset(s, s), BackgroundColor3 = C.Frost,
            BackgroundTransparency = rng:NextNumber(0.35, 0.85), BorderSizePixel = 0,
            Visible = i <= Window.Snow.Count,
        }, snowLayer)
        round(f, 3)
        flakes[i] = {
            f = f, bx = rng:NextNumber(0, W), y = rng:NextNumber(-10, H),
            spd = rng:NextNumber(14, 42), sway = rng:NextNumber(0.6, 1.6),
            amp = rng:NextNumber(6, 18), ph = rng:NextNumber(0, 6.28),
        }
    end

    function Window:SetSnow(on, count, speed)
        if on ~= nil then self.Snow.On = on end
        if count then self.Snow.Count = math.clamp(math.floor(count), 0, 60) end
        if speed then self.Snow.Speed = speed end
        for i, fl in ipairs(flakes) do
            fl.f.Visible = self.Snow.On and i <= self.Snow.Count
        end
    end

    -- ---------- ヘッダー ----------
    local header = new("Frame", {
        Size = UDim2.new(1, 0, 0, HEADER_H), BackgroundTransparency = 1, Active = true, ZIndex = 4,
    }, body)

    local logo = makeFlake(header, {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(34, 26),
        Size = UDim2.fromOffset(28, 28), ZIndex = 5,
    }, C.Ice)
    local titleLbl = text(header, {
        Position = UDim2.fromOffset(58, 8), Size = UDim2.fromOffset(240, 22),
        Font = F_BLACK, TextSize = 18, RichText = true, TextXAlignment = Enum.TextXAlignment.Left,
        Text = richTitle(cfg.Title or "FROZEN", cfg.Sub or "WARE"),
        ZIndex = 5,
    })
    text(header, {
        Position = UDim2.fromOffset(59, 29), Size = UDim2.fromOffset(240, 14),
        TextSize = 10, TextColor3 = C.Mute, TextXAlignment = Enum.TextXAlignment.Left,
        Text = cfg.Tagline or "arctic edition  ·  v1.0", ZIndex = 5,
    })

    local closeBtn = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0),
        Size = UDim2.fromOffset(26, 26), BackgroundColor3 = C.Card2, BackgroundTransparency = 0.3,
        Text = "×", Font = F_BOLD, TextSize = 16, TextColor3 = C.Mute, AutoButtonColor = false, ZIndex = 5,
