    -- =====================================================
    -- TUTORIAL (ガイドツアー)
    -- =====================================================
    Window.Anchors = { header = header, rail = rail, content = content, fps = fpsPill, grip = grip }
    local tutSteps = {}
    function Window:SetAnchor(name, obj) self.Anchors[name] = obj end
    function Window:AddTutorialStep(step) table.insert(tutSteps, step) end

    local SEEN_FILE = "frozenware_seen.txt"
    local function hasSeen()
        local ok, r = pcall(function() return isfile and isfile(SEEN_FILE) end)
        return ok and r == true
    end
    local function markSeen()
        pcall(function() if writefile then writefile(SEEN_FILE, "1") end end)
    end

    local tut = { Active = false, Token = 0 }

    function Window:StartTutorial()
        if tut.Active or #tutSteps == 0 then return end
        if not self.Visible then self:SetVisible(true) end
        tut.Active = true
        local TIPW, TIPH = 330, 156
        local index = 1
        local finish
        local keyConn

        local layer = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 80 }, gui)
        local ring = new("Frame", { BackgroundTransparency = 1, ZIndex = 81, Visible = false }, layer)
        round(ring, 10)
        local ringStroke = stroke(ring, C.Ice, 2.5, 0)
        local ring2 = new("Frame", { BackgroundTransparency = 1, ZIndex = 81, Visible = false }, layer)
        round(ring2, 16)
        local ring2Stroke = stroke(ring2, C.Frost, 1.5, 0.5)
        local ringShown = false

        local vp0 = gui.AbsoluteSize
        local tip = new("CanvasGroup", {
            Size = UDim2.fromOffset(TIPW, TIPH), Position = UDim2.fromOffset((vp0.X - TIPW) / 2, (vp0.Y - TIPH) / 2),
            BackgroundColor3 = C.Bg1, BorderSizePixel = 0, ZIndex = 82, GroupTransparency = 1,
        }, layer)
        round(tip, 12)
        stroke(tip, C.Ice, 2, 0.2)

        local stepLbl = text(tip, {
            Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -90, 0, 12), Font = F_BOLD, TextSize = 10,
            TextColor3 = C.Ice, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 83,
        })
        local titleLbl = text(tip, {
            Position = UDim2.fromOffset(16, 28), Size = UDim2.new(1, -32, 0, 20), Font = F_BOLD, TextSize = 15,
            TextColor3 = C.Frost, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 83,
        })
        local bodyLbl = text(tip, {
            Position = UDim2.fromOffset(16, 52), Size = UDim2.new(1, -32, 0, 56), TextSize = 12, TextColor3 = C.Text,
            TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 83,
        })

        local skipBtn = new("TextButton", {
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 8), Size = UDim2.fromOffset(60, 18),
            BackgroundTransparency = 1, Text = "skip ×", Font = F_BOLD, TextSize = 10, TextColor3 = C.Mute, ZIndex = 84,
        }, tip)

        local function mkBtn(label, primary, x, w)
            local b = new("TextButton", {
                AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, x, 0, TIPH - 40), Size = UDim2.fromOffset(w, 28),
                BackgroundColor3 = primary and C.Ice2 or C.Card, Text = label, Font = F_BOLD, TextSize = 12,
                TextColor3 = primary and Color3.new(1, 1, 1) or C.Text, AutoButtonColor = false, ZIndex = 84,
            }, tip)
            round(b, 8)
            local base = primary and C.Ice2 or C.Card
            b.MouseEnter:Connect(function() tween(b, 0.12, { BackgroundColor3 = primary and C.Ice or C.Card2 }) end)
            b.MouseLeave:Connect(function() tween(b, 0.12, { BackgroundColor3 = base }) end)
            return b
        end
        local nextBtn = mkBtn("Next ▶", true, -16, 92)
        local backBtn = mkBtn("◀ Back", false, -116, 68)

        local dotsHolder = new("Frame", {
            Position = UDim2.fromOffset(16, TIPH - 30), Size = UDim2.fromOffset(150, 10), BackgroundTransparency = 1, ZIndex = 83,
        }, tip)
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5),
            VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
        }, dotsHolder)
        local dots = {}
        for i = 1, #tutSteps do
            local d = new("Frame", {
                Size = UDim2.fromOffset(6, 6), BackgroundColor3 = C.Line, BorderSizePixel = 0, LayoutOrder = i, ZIndex = 84,
            }, dotsHolder)
            round(d, 3)
            dots[i] = d
        end
        local function updateDots()
            for i, d in ipairs(dots) do
                tween(d, 0.25, {
                    Size = UDim2.fromOffset(i == index and 16 or 6, 6),
                    BackgroundColor3 = i == index and C.Ice or C.Line,
                })
            end
        end

        local curObj = nil
        local rp, rsz, tp = Vector2.new(), Vector2.new(), nil

        -- すべて layer 基準の座標で計算 (インセット差や親のずれを吸収)
        local function computeTarget()
            local vp = layer.AbsoluteSize
            local origin = layer.AbsolutePosition
            local x, y
            if curObj and curObj.Parent then
                local p = curObj.AbsolutePosition - origin
                local sz = curObj.AbsoluteSize
                if sz.X > 360 or sz.Y > 300 then
                    x = p.X + sz.X / 2 - TIPW / 2
                    y = p.Y + sz.Y - TIPH - 16
                else
                    x = p.X + sz.X + 20
                    y = p.Y + sz.Y / 2 - TIPH / 2
                    if x + TIPW > vp.X - 10 then x = p.X - TIPW - 20 end
                    if x < 10 then
                        x = p.X
                        y = p.Y + sz.Y + 20
                        if y + TIPH > vp.Y - 10 then y = p.Y - TIPH - 20 end
                    end
                end
                x = math.clamp(x, 10, vp.X - TIPW - 10)
                y = math.clamp(y, 10, vp.Y - TIPH - 10)
                return p, sz, Vector2.new(x, y)
            end
            return nil, nil, Vector2.new((vp.X - TIPW) / 2, (vp.Y - TIPH) / 2)
        end

        local function show(i)
            if not tut.Active then return end
            tut.Token = tut.Token + 1
            local my = tut.Token
            index = i
            local st = tutSteps[i]
            stepLbl.Text = string.format("STEP %d / %d", i, #tutSteps)
            titleLbl.Text = st.Title or ""
            bodyLbl.Text = st.Text or ""
            nextBtn.Text = (i == #tutSteps) and "Finish" or "Next ▶"
            backBtn.Visible = i > 1
            updateDots()
            titleLbl.TextTransparency = 1
            bodyLbl.TextTransparency = 1
            if st.Tab and activeIdx ~= st.Tab then
                selectTab(st.Tab)
                task.wait(0.6)
            else
                task.wait(0.05)
            end
            if not tut.Active or my ~= tut.Token then return end
            curObj = st.Anchor and Window.Anchors[st.Anchor] or nil
            tween(tip, 0.35, { GroupTransparency = 0 })
            tween(titleLbl, 0.4, { TextTransparency = 0 })
            tween(bodyLbl, 0.55, { TextTransparency = 0 })
        end

        finish = function(completed)
            if not tut.Active then return end
            tut.Active = false
            tut.Token = tut.Token + 1
            if keyConn then keyConn:Disconnect() end
            markSeen()
            tween(tip, 0.3, { GroupTransparency = 1 })
            ring.Visible, ring2.Visible = false, false
            task.delay(0.4, function() if layer.Parent then layer:Destroy() end end)
            if completed then
                Lib:Notify("Tutorial", "完了！ Settings の Replay Tutorial でいつでも見返せます。", 4)
            end
        end

        nextBtn.MouseButton1Click:Connect(function()
            if index >= #tutSteps then finish(true) else task.spawn(show, index + 1) end
        end)
        backBtn.MouseButton1Click:Connect(function()
            if index > 1 then task.spawn(show, index - 1) end
        end)
        skipBtn.MouseButton1Click:Connect(function() finish(false) end)

        keyConn = UserInputService.InputBegan:Connect(function(input)
            if not tut.Active then return end
            if input.KeyCode == Enum.KeyCode.Right or input.KeyCode == Enum.KeyCode.Return then
                if index >= #tutSteps then finish(true) else task.spawn(show, index + 1) end
            elseif input.KeyCode == Enum.KeyCode.Left then
                if index > 1 then task.spawn(show, index - 1) end
            elseif input.KeyCode == Enum.KeyCode.Escape then
                finish(false)
            end
        end)

        task.spawn(function()
            local t0 = 0
            while tut.Active and layer.Parent do
                local dt = task.wait()
                t0 = t0 + dt
                local alpha = 1 - math.exp(-dt * 14)
                local p, sz, tpos = computeTarget()
                if p then
                    local pd = 7
                    local goalP = p - Vector2.new(pd, pd)
                    local goalS = sz + Vector2.new(pd * 2, pd * 2)
                    if not ringShown then
                        rp, rsz, ringShown = goalP, goalS, true
                    else
                        rp = rp:Lerp(goalP, alpha)
                        rsz = rsz:Lerp(goalS, alpha)
                    end
                    ring.Position = UDim2.fromOffset(rp.X, rp.Y)
                    ring.Size = UDim2.fromOffset(rsz.X, rsz.Y)
                    ring2.Position = UDim2.fromOffset(rp.X - 6, rp.Y - 6)
                    ring2.Size = UDim2.fromOffset(rsz.X + 12, rsz.Y + 12)
                    ring.Visible, ring2.Visible = true, true
                else
                    ring.Visible, ring2.Visible, ringShown = false, false, false
                end
                tp = tp and tp:Lerp(tpos, alpha) or tpos
                tip.Position = UDim2.fromOffset(tp.X, tp.Y)
                local k = 0.5 + 0.5 * math.sin(t0 * 4)
                ringStroke.Transparency = 0.05 + 0.35 * (1 - k)
                ring2Stroke.Transparency = 0.35 + 0.6 * k
            end
        end)

        task.spawn(show, 1)
    end

    -- =====================================================
    -- CUTSCENE (オープニング)
    -- =====================================================
    local Lighting = game:GetService("Lighting")
    local cutsceneBusy = false

    function Window:PlayCutscene(done)
        if cutsceneBusy then return end
        cutsceneBusy = true
        if self.Visible then self:SetVisible(false) end

        local skipped, finished = false, false
        local cs = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 100 }, gui)
        local vp = gui.AbsoluteSize
        local rngc = Random.new(os.clock() * 1000)

        -- ライティング演出 (明るく冷たい色味)
        local cc, blur, bloom
