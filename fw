-- =========================================================
--  サウンド置換エンジン
--   HIT : 13110130082 / 16537337310  → Hit のテキストボックスのサウンド
--   KILL: 16530229616               → Kill のテキストボックスのサウンド
-- =========================================================
local HIT_IDS  = { ["13110130082"] = true, ["16537337310"] = true }
local KILL_IDS = { ["16530229616"] = true }

local function normalizeId(raw)
    if type(raw) ~= "string" then return nil end
    raw = raw:gsub("%s+", "")
    if raw == "" then return nil end
    if raw:match("^rbxassetid://") or raw:match("^rbxasset://") then return raw end
    local n = raw:match("(%d+)")
    if n then return "rbxassetid://" .. n end
    return nil
end

local swapEntries = setmetatable({}, { __mode = "k" })

local function classify(id)
    local n = string.match(tostring(id or ""), "%d+")
    if not n then return nil end
    if HIT_IDS[n] then return "hit" end
    if KILL_IDS[n] then return "kill" end
    return nil
end
local function customFor(kind)
    if kind == "hit" then
        if not Cfg.HitEnabled then return nil end
        return normalizeId(Cfg.HitSoundId)
    elseif kind == "kill" then
        if not Cfg.KillEnabled then return nil end
        return normalizeId(Cfg.KillSoundId)
    end
end
local function volumeFor(kind)
    if kind == "hit" then return math.clamp(Cfg.HitVolume, 0, 10) end
    if kind == "kill" then return math.clamp(Cfg.KillVolume, 0, 10) end
    return 1
end

local applySwap
local function trackSound(sound)
    local entry = { orig = sound.SoundId, kind = classify(sound.SoundId), origVolume = sound.Volume }
    swapEntries[sound] = entry
    conn(sound:GetPropertyChangedSignal("SoundId"), function()
        local cur = sound.SoundId
        if cur == entry.expect then return end      -- 自分が代入した値
        entry.orig = cur                            -- ゲーム側が変更/再設定した
        entry.kind = classify(cur)
        entry.expect = nil
        if not entry.kind then entry.mine = nil end
        applySwap(sound)
    end)
    conn(sound:GetPropertyChangedSignal("Volume"), function()
        if not entry.mine or not entry.kind then return end
        local v = sound.Volume
        if v <= 0.001 then return end               -- ゲームがミュートしたら尊重 (鳴りっぱなし防止)
        local want = volumeFor(entry.kind)
        if math.abs(v - want) > 0.01 then pcall(function() sound.Volume = want end) end
    end)
    return entry
end

applySwap = function(sound)
    if not sound or not sound:IsA("Sound") then return end
    local entry = swapEntries[sound]
    if not entry then
        if not classify(sound.SoundId) then return end
        entry = trackSound(sound)
    end
    if not entry.kind then entry.mine = nil; return end

    local id = customFor(entry.kind)
    if id then
        entry.mine = id
        if sound.SoundId ~= id then
            entry.expect = id
            sound.SoundId = id
        end
        local want = volumeFor(entry.kind)
        if sound.Volume > 0.001 and math.abs(sound.Volume - want) > 0.01 then
            pcall(function() sound.Volume = want end)
        end
    elseif entry.mine then
        entry.mine = nil
        if sound.SoundId ~= entry.orig then
            entry.expect = entry.orig
            sound.SoundId = entry.orig
        end
        pcall(function() sound.Volume = entry.origVolume or 1 end)
    end
end

local function refreshSwaps()
    for sound in pairs(swapEntries) do pcall(applySwap, sound) end
end

local function considerSound(d)
    if not d:IsA("Sound") then return end
    if classify(d.SoundId) then
        pcall(applySwap, d)
    elseif d.SoundId == "" then
        local c
        c = d:GetPropertyChangedSignal("SoundId"):Connect(function()
            if classify(d.SoundId) then
                c:Disconnect()
                pcall(applySwap, d)
            elseif d.SoundId ~= "" then
                c:Disconnect()
            end
        end)
        table.insert(Lib.Connections, c)
    end
end
