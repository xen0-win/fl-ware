    -- ---------- 画面外に出ていたら戻す ----------
    local function clampOnScreen()
        task.defer(function()
            local vp = gui.AbsoluteSize
            if vp.X < 100 then return end
            local ap = shell.AbsolutePosition
            local dx, dy = 0, 0
            if ap.X + W < 120 then dx = 120 - (ap.X + W) elseif ap.X > vp.X - 120 then dx = (vp.X - 120) - ap.X end
            if ap.Y < 0 then dy = -ap.Y elseif ap.Y > vp.Y - 60 then dy = (vp.Y - 60) - ap.Y end
            if dx ~= 0 or dy ~= 0 then
                local pp = shell.Position
                shell.Position = UDim2.new(pp.X.Scale, pp.X.Offset + dx, pp.Y.Scale, pp.Y.Offset + dy)
            end
        end)
    end

    -- ---------- マウス強制解除 ----------
    local UNLOCK_STEP = "FrozenWareUnlock"
    local savedIcon = nil
    local function enableUnlock()
        if savedIcon == nil then savedIcon = UserInputService.MouseIconEnabled end
        pcall(function() RunService:UnbindFromRenderStep(UNLOCK_STEP) end)
        RunService:BindToRenderStep(UNLOCK_STEP, Enum.RenderPriority.Last.Value, function()
            if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end
            if UserInputService.MouseIconEnabled then
                UserInputService.MouseIconEnabled = false
            end
        end)
        Lib.SetCursor(true)
    end
    local function disableUnlock()
        Lib.SetCursor(false)
        pcall(function() RunService:UnbindFromRenderStep(UNLOCK_STEP) end)
        if savedIcon ~= nil then
            pcall(function() UserInputService.MouseIconEnabled = savedIcon end)
            savedIcon = nil
        end
    end

