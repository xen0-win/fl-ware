    status.TextColor3 = col or C.mute
end

local urlBox, nameBox, listFrame, autoBtn, delayBox, showBtn, keyBtn
local refreshList, updateToggle, updateShow, updateKey

-- ===== Scripts ページ =====
urlBox  = box(pages.scripts, "https://raw.githubusercontent.com/...", UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 30))
nameBox = box(pages.scripts, "name", UDim2.fromOffset(0, 36), UDim2.new(1, 0, 0, 30))

btn(pages.scripts, "+  追加", UDim2.fromOffset(0, 72), UDim2.new(0.5, -4, 0, 30), C.sel, function()
    local url = trim(urlBox.Text):gsub("%s", "")
    if url == "" then
        say("URL欄が空です。https:// から始まるURLを入れてください", C.red)
        return
    end
    if not validUrl(url) then
        say("URLは https:// から始まる必要があります", C.red)
        return
    end
    local name = trim(nameBox.Text)
    if name == "" then name = "script " .. (#scripts + 1) end
    local i = findIndex(name)
    if i then
        scripts[i].url = url
    else
        scripts[#scripts + 1] = { name = name, url = url }
    end
    checked[name] = true
    saveScripts()
    refreshList()
    say("追加: " .. name, C.green)
end)

btn(pages.scripts, "×  チェックを削除", UDim2.new(0.5, 4, 0, 72), UDim2.new(0.5, -4, 0, 30), C.red, function()
    local names = checkedList()
    if #names == 0 then
        say("削除するスクリプトをチェックしてください", C.red)
        return
    end
    local rm = {}
    for _, n in ipairs(names) do rm[n] = true end

    local keep = {}
    for _, e in ipairs(scripts) do
        if not rm[e.name] then keep[#keep + 1] = e end
    end
    scripts = keep

    local nt = {}
    for _, n in ipairs(cfg.targets) do
        if not rm[n] then nt[#nt + 1] = n end
    end
    cfg.targets = nt
    if #nt == 0 then cfg.enabled = false end

    checked = {}
    saveScripts()
    saveSettings()
    refreshList()
    updateToggle()
    say("削除: " .. #names .. "件", C.mute)
end)

-- 全選択 / 全解除
btn(pages.scripts, "全選択", UDim2.fromOffset(0, 108), UDim2.new(0.5, -4, 0, 24), C.row, function()
    for _, e in ipairs(scripts) do checked[e.name] = true end
    refreshList()
end)
btn(pages.scripts, "全解除", UDim2.new(0.5, 4, 0, 108), UDim2.new(0.5, -4, 0, 24), C.row, function()
    checked = {}
    refreshList()
end)

listFrame = mk("ScrollingFrame", {
    Position = UDim2.fromOffset(0, 140), Size = UDim2.new(1, 0, 0, 114),
    BackgroundColor3 = C.card, BorderSizePixel = 0, ScrollBarThickness = 4,
    CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, pages.scripts)
corner(listFrame, 8)
mk("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, listFrame)
mk("UIPadding", {
    PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6),
    PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 6),
}, listFrame)

function refreshList()
    for _, ch in ipairs(listFrame:GetChildren()) do
        if ch:IsA("TextButton") then ch:Destroy() end
    end
    for i, e in ipairs(scripts) do
        local on = checked[e.name] == true
        local tgt = isTarget(e.name)
        local b = mk("TextButton", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = on and C.sel or C.row,
            AutoButtonColor = false,
            Text = (on and "[x]  " or "[ ]  ") .. (tgt and "★ " or "") .. e.name,
            Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = C.text,
            TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = i,
        }, listFrame)
        corner(b, 6)
        mk("UIPadding", { PaddingLeft = UDim.new(0, 6) }, b)
        local n = e.name
        b.MouseButton1Click:Connect(function()
            checked[n] = (not checked[n]) or nil
            refreshList()
        end)
    end
    local c = #checkedList()
    if c > 0 then say("チェック: " .. c .. "件", C.ice) end
end

btn(pages.scripts, "★  チェックを自動ロード対象に", UDim2.fromOffset(0, 262), UDim2.new(1, 0, 0, 28), C.row, function()
    local names = checkedList()
    if #names == 0 then
        say("自動ロード対象をチェックしてください", C.red)
        return
    end
    cfg.targets = names
    saveSettings()
    refreshList()
    updateToggle()
    say("自動ロード対象: " .. #names .. "件", C.green)
end)

autoBtn = btn(pages.scripts, "", UDim2.fromOffset(0, 298), UDim2.new(1, 0, 0, 28), C.row, function()
    local on = not cfg.enabled
    if on then
        if #cfg.targets == 0 then
            say("先に自動ロード対象を設定してください", C.red)
            return
        end
        local ok, err = queueBootstrap()
        if not ok then
            say(err, C.red)
            return
        end
    end
    cfg.enabled = on
    saveSettings()
    updateToggle()
    if on then
        say("テレポート後に " .. #cfg.targets .. "件を自動ロードします", C.green)
    else
        say("自動ロードOFF", C.mute)
    end
end)

function updateToggle()
    autoBtn.Text = "Auto Load on Teleport:  " .. (cfg.enabled and "ON" or "OFF") .. "  (" .. #cfg.targets .. "件)"
    autoBtn.BackgroundColor3 = cfg.enabled and C.green or C.row
end

-- ===== Settings ページ =====
mk("TextLabel", {
    Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1,
    Text = "Auto Load Delay (秒, 0〜30)", Font = Enum.Font.GothamBold, TextSize = 12,
    TextColor3 = C.mute, TextXAlignment = Enum.TextXAlignment.Left,
}, pages.settings)

delayBox = box(pages.settings, "5", UDim2.fromOffset(0, 22), UDim2.new(0, 120, 0, 30))
delayBox.Text = tostring(cfg.delay)
delayBox.FocusLost:Connect(function()
    local n = tonumber(delayBox.Text)
    n = n and math.clamp(n, 0, 30) or cfg.delay
    cfg.delay = n
    delayBox.Text = tostring(n)
    saveSettings()
    say("遅延: " .. n .. "s", C.green)
end)

function updateShow()
    showBtn.Text = "Show UI on Startup:  " .. (cfg.showUI and "ON" or "OFF")
end
showBtn = btn(pages.settings, "", UDim2.fromOffset(0, 70), UDim2.new(1, 0, 0, 30), C.row, function()
    cfg.showUI = not cfg.showUI
    saveSettings()
    updateShow()
end)

-- キーバインド
local listeningKey = false
function updateKey()
    if listeningKey then
        keyBtn.Text = "キーを押してください  (Esc でキャンセル)"
    else
        keyBtn.Text = "UI Toggle Key:  " .. cfg.key
    end
end
keyBtn = btn(pages.settings, "", UDim2.fromOffset(0, 110), UDim2.new(1, 0, 0, 30), C.row, function()
    listeningKey = true
    updateKey()
    say("割り当てるキーを押してください", C.ice)
end)

mk("TextLabel", {
    Position = UDim2.fromOffset(0, 148), Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1,
    Text = "起動時のUI表示。キーでいつでも開閉できます。",
    Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = C.mute,
    TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
    TextWrapped = true,
}, pages.settings)

-- ===== キー入力 =====
UIS.InputBegan:Connect(function(i, gp)
    if listeningKey then
        if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
        listeningKey = false
        if i.KeyCode ~= Enum.KeyCode.Escape then
            cfg.key = i.KeyCode.Name
            saveSettings()
            say("キーを " .. cfg.key .. " に設定しました", C.green)
        else
            say("キーバインドをキャンセルしました", C.mute)
        end
        updateKey()
        return
    end
    if gp then return end
    local k = keyFromName(cfg.key)
    if k and i.KeyCode == k then
        main.Visible = not main.Visible
    end
end)

-- ===== 起動処理 =====
showPage("scripts")
refreshList()
updateToggle()
updateShow()
updateKey()
saveSettings()  -- 旧形式からの移行をファイルに反映
if cfg.enabled then
    local ok, err = queueBootstrap()
    if not ok then say(err, C.red) end
end
