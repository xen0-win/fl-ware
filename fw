local function getAsset(url)
    local ok, result = pcall(function()
        if writefile and isfile and getcustomasset then
            local fileName = "ss_" .. (url:match("([^/]+)$") or tostring(#url))
            if not isfile(fileName) then
                local data = game:HttpGet(url)
                if data and #data > 80 then writefile(fileName, data) end
            end
            local asset = getcustomasset(fileName)
            if asset and asset ~= "" then return asset end
        end
        return url
    end)
    return (ok and result) or url
end
local PackIdMap
local function buildPackIdMap()
    if PackIdMap then return PackIdMap end
    PackIdMap = {}
    for _, rule in ipairs(PACK_RULES) do
        local asset = getAsset(PACK_BASE .. rule.file)
        for _, id in ipairs(rule.ids) do PackIdMap[tostring(id)] = asset end
    end
    return PackIdMap
end
local packOriginal = setmetatable({}, { __mode = "k" })
local function applyPackToObject(obj)
    local map = buildPackIdMap()
    local function replace(prop)
        local ok, val = pcall(function() return obj[prop] end)
        if not ok or type(val) ~= "string" then return end
        local id = string.match(val, "%d+")
        if id and map[id] then
            packOriginal[obj] = packOriginal[obj] or {}
            if packOriginal[obj][prop] == nil then packOriginal[obj][prop] = val end
            pcall(function() obj[prop] = map[id] end)
        end
    end
    if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then replace("Image")
    elseif obj:IsA("Decal") or obj:IsA("Texture") then replace("Texture")
    elseif obj:IsA("MeshPart") then replace("TextureID") end
end
