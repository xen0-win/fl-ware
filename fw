local queued = false
local function setAutoLoadUrl()
    if getgenv then getgenv()[URL_FLAG] = Cfg.AutoLoadUrl end
end
local function validUrl(u)
    return type(u) == "string" and u:match("^https?://") ~= nil and not u:find("example.com", 1, true)
end
local function setAutoLoad(enabled)
    -- 1. グローバルフラグ (テレポート後も引き継がれる)
    if getgenv then getgenv()[FLAG_NAME] = not enabled end
    -- 2. OFF / 既にキュー済みなら何もしない
    if not enabled then return true end
    if queued then return true end
    -- 3. queue_on_teleport が無いexecutorは不可
    if not queue_on_teleport then
        warn("AutoLoad: this executor has no queue_on_teleport")
        Lib:Notify("Auto Load", "このexecutorは queue_on_teleport に対応していません。", 4)
        return false
    end
    if not validUrl(Cfg.AutoLoadUrl) then
        Lib:Notify("Auto Load", "有効な Script URL を入力してください。", 4)
        return false
    end
    setAutoLoadUrl()
    -- 4. テレポート後に実行するコードを予約
    queue_on_teleport(([[
local g = getgenv()
if g.%s then return end
if not game:IsLoaded() then game.Loaded:Wait() end
task.wait(5)
local url = g.%s or %q
local ok, err = pcall(function()
    loadstring(game:HttpGet(url))()
end)
if not ok then warn("AutoLoad: " .. tostring(err)) end
]]):format(FLAG_NAME, URL_FLAG, Cfg.AutoLoadUrl))
    queued = true
    -- 5. 通知
    Lib:Notify("Auto Load", "Auto load queued for teleports", 3)
    return true
end

