    -- ---------- ドラッグ / リサイズ ----------
    local mode, moved = nil, false
    local startMouse, startAbs, startSize, pendingPos, pendingSize

    local function isPress(i)
        return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
    end

    header.InputBegan:Connect(function(i)
        if mode or not isPress(i) then return end
        mode, moved = "move", false
        startMouse = Vector2.new(i.Position.X, i.Position.Y)
        startAbs = shell.AbsolutePosition
        pendingPos = startAbs
    end)
    grip.InputBegan:Connect(function(i)
        if mode or not isPress(i) then return end
        mode, moved = "resize", false
        gripActive = true
        paintGrip(C.Ice)
        startMouse = Vector2.new(i.Position.X, i.Position.Y)
        startAbs = shell.AbsolutePosition
        startSize = Vector2.new(W, H)
        pendingSize = startSize
    end)

    conn(UserInputService.InputChanged, function(i)
        if not mode then return end
        if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
        local d = Vector2.new(i.Position.X, i.Position.Y) - startMouse
        if not moved and d.Magnitude < 4 then return end
        moved = true
        local vp = gui.AbsoluteSize
        if mode == "move" then
            local x = math.clamp(startAbs.X + d.X, 90 - W, vp.X - 90)
            local y = math.clamp(startAbs.Y + d.Y, 0, vp.Y - 50)
            pendingPos = Vector2.new(x, y)
            showOutline(pendingPos, Vector2.new(W, H), "")
        else
            local maxW = math.max(MIN_W, vp.X - startAbs.X - 6)
            local maxH = math.max(MIN_H, vp.Y - startAbs.Y - 6)
            local nw = math.clamp(startSize.X + d.X, MIN_W, maxW)
            local nh = math.clamp(startSize.Y + d.Y, MIN_H, maxH)
            pendingSize = Vector2.new(math.floor(nw + 0.5), math.floor(nh + 0.5))
            showOutline(startAbs, pendingSize, string.format("%d x %d", pendingSize.X, pendingSize.Y))
        end
    end)

    conn(UserInputService.InputEnded, function(i)
        if not mode or not isPress(i) then return end
        local m = mode
        mode = nil
        if m == "resize" then
            gripActive = false
            paintGrip(C.Mute)
        end
        if not moved then return end

        local pp = shell.Position
        if m == "move" then
            local d = pendingPos - startAbs
            tween(shell, 0.4, {
                Position = UDim2.new(pp.X.Scale, pp.X.Offset + d.X, pp.Y.Scale, pp.Y.Offset + d.Y),
            }, Enum.EasingStyle.Quint)
        else
            local oldW, oldH = W, H
