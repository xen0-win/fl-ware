-- =========================================================
--  Auto Loader (standalone)
--  URL登録 / 複数選択 / 自動ロード(複数) / 遅延 / UI表示 / キーバインド
-- =========================================================
local Players      = game:GetService("Players")
local HttpService  = game:GetService("HttpService")
local UIS          = game:GetService("UserInputService")

local G = (getgenv and getgenv()) or _G
local DIR           = "autoloader"
local SCRIPTS_FILE  = DIR .. "/scripts.json"
local SETTINGS_FILE = DIR .. "/settings.json"
local FS = (writefile ~= nil and readfile ~= nil and isfile ~= nil)

if makefolder and isfolder then
    pcall(function() if not isfolder(DIR) then makefolder(DIR) end end)
end

local function trim(s)
    s = tostring(s or "")
    s = s:gsub("^%s+", "")
    s = s:gsub("%s+$", "")
    return s
end
local function readJson(path)
    if not (FS and isfile(path)) then return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if ok and type(data) == "table" then return data end
    return nil
end
local function writeJson(path, t)
    if not FS then return end
    pcall(function() writefile(path, HttpService:JSONEncode(t)) end)
end
local function validUrl(u)
    return type(u) == "string" and u:match("^https?://") ~= nil
end
local function keyFromName(name)
    if type(name) ~= "string" then return nil end
    local ok, k = pcall(function() return Enum.KeyCode[name] end)
    return (ok and typeof(k) == "EnumItem") and k or nil
end

-- ---------- 状態 ----------
local scripts = {}
local cfg = { enabled = false, targets = {}, delay = 5, showUI = true, key = "RightShift" }
local checked = {}  -- name -> true (リストでチェックされているもの)

do
    local s = readJson(SCRIPTS_FILE)
    if s and type(s.list) == "table" then
        for _, e in ipairs(s.list) do
            if type(e) == "table" and validUrl(e.url) then
                scripts[#scripts + 1] = { name = tostring(e.name or e.url), url = e.url }
            end
        end
    end
    local c = readJson(SETTINGS_FILE)
    if c then
        cfg.enabled = c.enabled == true
        cfg.delay   = math.clamp(tonumber(c.delay) or 5, 0, 30)
        cfg.showUI  = c.showUI ~= false
        if keyFromName(c.key) then cfg.key = c.key end

        -- 旧形式 (target: 1つ) からの移行
        if type(c.targets) == "table" then
            for _, n in ipairs(c.targets) do
                if type(n) == "string" then cfg.targets[#cfg.targets + 1] = n end
            end
        elseif type(c.target) == "string" then
            cfg.targets[1] = c.target
        end
    end
    -- 存在しないスクリプトを対象から外す
    local exists, filtered = {}, {}
    for _, e in ipairs(scripts) do exists[e.name] = true end
    for _, n in ipairs(cfg.targets) do
        if exists[n] then filtered[#filtered + 1] = n end
    end
    cfg.targets = filtered
    if #cfg.targets == 0 then cfg.enabled = false end
end

local function saveScripts() writeJson(SCRIPTS_FILE, { list = scripts }) end
local function saveSettings() writeJson(SETTINGS_FILE, cfg) end
local function findIndex(name)
    for i, e in ipairs(scripts) do
        if e.name == name then return i end
    end
    return nil
end
local function isTarget(name)
    for _, n in ipairs(cfg.targets) do
        if n == name then return true end
    end
    return false
end
local function checkedList()
    local out = {}
    for _, e in ipairs(scripts) do
        if checked[e.name] then out[#out + 1] = e.name end
    end
    return out
end

-- ---------- テレポート後のブートストラップ ----------
local WRAPPER = 'if getgenv().AL_BOOT then loadstring(getgenv().AL_BOOT)() end'
local BOOT_SRC = ([==[
local WRAPPER, SCRIPTS_FILE, SETTINGS_FILE = %q, %q, %q
local function rd(p)
    if not (isfile and readfile and isfile(p)) then return nil end
    local ok, d = pcall(function() return game:GetService("HttpService"):JSONDecode(readfile(p)) end)
    return ok and d or nil
end
local c = rd(SETTINGS_FILE)
if type(c) ~= "table" or c.enabled ~= true or type(c.targets) ~= "table" or #c.targets == 0 then return end
if queue_on_teleport then queue_on_teleport(WRAPPER) end
local s = rd(SCRIPTS_FILE)
local urls = {}
if type(s) == "table" and type(s.list) == "table" then
    for _, name in ipairs(c.targets) do
        for _, e in ipairs(s.list) do
            if type(e) == "table" and e.name == name and type(e.url) == "string" then
                urls[#urls + 1] = { name = name, url = e.url }
            end
        end
    end
end
if #urls == 0 then return end
if not game:IsLoaded() then game.Loaded:Wait() end
task.wait(tonumber(c.delay) or 5)
for _, u in ipairs(urls) do
    local ok, err = pcall(function() loadstring(game:HttpGet(u.url))() end)
    if not ok then warn("AutoLoader [" .. u.name .. "]: " .. tostring(err)) end
end
]==]):format(WRAPPER, SCRIPTS_FILE, SETTINGS_FILE)

local queued = false
local function queueBootstrap()
    if queued then return true end
    if not queue_on_teleport then
        return false, "このexecutorは queue_on_teleport に非対応です"
    end
    G.AL_BOOT = BOOT_SRC
    queue_on_teleport(WRAPPER)
    queued = true
    return true
end

-- ---------- UI ----------
local C = {
    bg    = Color3.fromRGB(24, 30, 44),
    card  = Color3.fromRGB(34, 42, 62),
    row   = Color3.fromRGB(44, 54, 80),
    sel   = Color3.fromRGB(70, 110, 170),
    ice   = Color3.fromRGB(120, 200, 255),
    text  = Color3.fromRGB(230, 240, 250),
    mute  = Color3.fromRGB(150, 165, 190),
    red   = Color3.fromRGB(200, 70, 80),
    green = Color3.fromRGB(80, 170, 120),
}

local function mk(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function corner(o, r) mk("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function btn(parent, label, pos, size, color, cb)
    local b = mk("TextButton", {
        Position = pos, Size = size, BackgroundColor3 = color, Text = label,
        Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.text, AutoButtonColor = true,
    }, parent)
    corner(b, 8)
    b.MouseButton1Click:Connect(function() if cb then cb() end end)
    return b
end
local function box(parent, placeholder, pos, size)
    local tb = mk("TextBox", {
        Position = pos, Size = size, BackgroundColor3 = C.row, Text = "",
        PlaceholderText = placeholder, PlaceholderColor3 = C.mute, TextColor3 = C.text,
        Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
    }, parent)
    corner(tb, 8)
    mk("UIPadding", { PaddingLeft = UDim.new(0, 8) }, tb)
    return tb
end

