--  WING (Angel Aura)  ※ AuraEngine は元スクリプトを簡略化して組み込み
-- =========================================================
local AuraEngine = {}
local auraState = { instances = {}, roots = {}, rig = nil, lifted = 0 }

local BONE_MAP = {
    Head = { "Head" },
    UpperTorso = { "UpperTorso", "Torso" },
    LowerTorso = { "LowerTorso" },
    RightUpperArm = { "RightUpperArm", "Right Arm" },
    RightLowerArm = { "RightLowerArm", "Right Arm" },
    RightHand = { "RightHand", "Right Arm" },
    LeftUpperArm = { "LeftUpperArm", "Left Arm" },
    LeftLowerArm = { "LeftLowerArm", "Left Arm" },
    LeftHand = { "LeftHand", "Left Arm" },
    RightUpperLeg = { "RightUpperLeg", "Right Leg" },
    RightLowerLeg = { "RightLowerLeg", "Right Leg" },
    LeftUpperLeg = { "LeftUpperLeg", "Left Leg" },
    LeftLowerLeg = { "LeftLowerLeg", "Left Leg" },
    HumanoidRootPart = { "HumanoidRootPart" },
    Torso = { "Torso", "UpperTorso" },
}

local function resolveBone(node)
    local candidates = BONE_MAP[node.name]
    if not candidates then return nil end
    for _, name in ipairs(candidates) do
        local found = auraState.rig:FindFirstChild(name)
        if found and found:IsA("BasePart") then return found end
    end
    return nil
end

function AuraEngine.Unload()
    for _, inst in pairs(auraState.instances) do
        if inst and inst.Parent then pcall(function() inst:Destroy() end) end
    end
    for _, anchor in pairs(auraState.roots) do
        if anchor and anchor.Parent then pcall(function() anchor:Destroy() end) end
    end
    auraState.instances = {}
    auraState.roots = {}
    auraState.lifted = 0
end

function AuraEngine.Load(tree, character)
    AuraEngine.Unload()
    if type(tree) ~= "table" or not character then return false end
    auraState.rig = character
    local nodes = tree.nodes or {}

    local byId = {}
    for _, node in ipairs(nodes) do byId[node.id] = node end

    -- インスタンス生成
    for _, node in ipairs(nodes) do
        local ok, inst = pcall(Instance.new, node.class)
        if ok and inst then
            for key, value in pairs(node.props or {}) do
                if key ~= "CFrame" then pcall(function() inst[key] = value end) end
            end
            auraState.instances[node.id] = inst
        else
            warn("[wing] could not create " .. tostring(node.class))
        end
    end

    -- 親子付け (ルートは骨にウェルド)
    for _, node in ipairs(nodes) do
        local inst = auraState.instances[node.id]
        if inst then
            if node.parent == 0 then
                local bone = resolveBone(node)
                if bone then
                    inst.Name = "AuraRoot_" .. node.name
                    inst.CanCollide = false
                    inst.CanTouch = false
                    inst.CanQuery = false
                    inst.Massless = true
                    inst.CastShadow = false
                    inst.Transparency = 1
                    inst.CFrame = bone.CFrame
                    inst.Parent = bone
                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = inst
                    weld.Part1 = bone
                    weld.Parent = inst
                    auraState.roots[node.id] = inst
                end
            else
                local parentNode = byId[node.parent]
                local parentInst = auraState.instances[node.parent]
                -- Attachment の子 Attachment は親のパーツまで持ち上げる
                if inst:IsA("Attachment") and parentNode and parentNode.class == "Attachment" then
                    local topNode = parentNode
                    while topNode do
                        local up = byId[topNode.parent]
                        if not up or up.class ~= "Attachment" then break end
                        topNode = up
                    end
                    local partNode = topNode and byId[topNode.parent]
                    if partNode and partNode.class ~= "Attachment" then
                        parentInst = auraState.instances[partNode.id]
                        auraState.lifted = auraState.lifted + 1
                    end
                end
                if parentInst then inst.Parent = parentInst end
            end
        end
    end

    -- Beam の Attachment0 / Attachment1
    for _, link in ipairs(tree.links or {}) do
        local beam = auraState.instances[link[1]]
        local a0 = auraState.instances[link[2]]
        local a1 = auraState.instances[link[3]]
        if beam and a0 and a1 then
            pcall(function() beam.Attachment0 = a0; beam.Attachment1 = a1 end)
        end
    end

    -- Attachment の CFrame
    for _, node in ipairs(nodes) do
        local inst = auraState.instances[node.id]
        if inst and inst:IsA("Attachment") and node.props and node.props.CFrame then
            pcall(function() inst.CFrame = node.props.CFrame end)
        end
    end

    local rootCount = 0
    for _ in pairs(auraState.roots) do rootCount = rootCount + 1 end
    if rootCount == 0 then
        warn("[wing] no root could be attached to a bone (check the character rig)")
        return false
    end
    return true
end

function AuraEngine.GetInstances()
    local out = {}
    for _, inst in pairs(auraState.instances) do
        if inst and inst.Parent then out[#out + 1] = inst end
    end
    return out
end

