-- =========================================================
-- HELPERS
-- =========================================================
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function tween(o, t, props, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function round(p, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, p) end

local function stroke(p, col, th, tr)
    return new("UIStroke", {
        Color = col or C.Line, Thickness = th or 1, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, p)
end

local function pad(p, t, r, b, l)
    return new("UIPadding", {
        PaddingTop = UDim.new(0, t or 0), PaddingRight = UDim.new(0, r or 0),
        PaddingBottom = UDim.new(0, b or 0), PaddingLeft = UDim.new(0, l or 0),
    }, p)
end

local function grad(p, cs, rot, ts)
    local g = Instance.new("UIGradient")
    g.Color = cs
    if ts then g.Transparency = ts end
    g.Rotation = rot or 0
    g.Parent = p
    return g
end

local function vlist(p, gap)
    return new("UIListLayout", { Padding = UDim.new(0, gap or 0), SortOrder = Enum.SortOrder.LayoutOrder }, p)
end

local function text(parent, props)
    props.BackgroundTransparency = 1
    props.Font = props.Font or F_REG
    props.TextColor3 = props.TextColor3 or C.Text
    props.TextSize = props.TextSize or 12
    return new("TextLabel", props, parent)
end

local function conn(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Lib.Connections, c)
    return c
end

local function getParent()
    if gethui then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    local ok = pcall(function() return game:GetService("CoreGui").Name end)
    if ok then return game:GetService("CoreGui") end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function rgbTag(c)
    return string.format("rgb(%d,%d,%d)", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end
local function richTitle(a, b)
    return '<font color="' .. rgbTag(C.Frost) .. '">' .. a .. '</font> <font color="' .. rgbTag(C.Ice) .. '">' .. b .. '</font>'
end

-- 雪の結晶を図形で描く (フォント依存の記号が出ない環境でも見える)
local function makeFlake(parent, props, color)
    props.BackgroundTransparency = 1
    local f = new("Frame", props, parent)
    local parts = {}
    color = color or C.Ice
    for i = 0, 2 do
        local arm = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromScale(0.07, 1), BackgroundColor3 = color, BorderSizePixel = 0, Rotation = i * 60,
        }, f)
        new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, arm)
        parts[#parts + 1] = arm
        for _, yy in ipairs({ 0.17, 0.83 }) do
            local br = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, yy),
                Size = UDim2.fromScale(4.2, 0.05), BackgroundColor3 = color, BorderSizePixel = 0,
            }, arm)
            parts[#parts + 1] = br
        end
    end
    local dot = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(0.2, 0.2), BackgroundColor3 = color, BorderSizePixel = 0, Rotation = 45,
    }, f)
    parts[#parts + 1] = dot
    return f, parts
end

-- 3Dネオン雪結晶 (ViewportFrame用)。芯・中・外の3層で発光っぽく見せる
local function buildFlake3D(vf)
    local model = Instance.new("Model")
    model.Name = "NeonFlake"
    local pivot = Instance.new("Part")
    pivot.Name = "Pivot"; pivot.Anchored = true; pivot.CanCollide = false; pivot.Transparency = 1
    pivot.Size = Vector3.new(0.1, 0.1, 0.1); pivot.CFrame = CFrame.new(); pivot.Parent = model
    model.PrimaryPart = pivot

    local L = 10
    local layers = {
        { thick = 0.12, color = C.Frost, tr = 0 },
        { thick = 0.30, color = C.Ice,  tr = 0.55, pulse = true },
        { thick = 0.75, color = C.Ice2, tr = 0.86, pulse = true },
    }
    local pulsers = {}
    local function mk(shape, size, cf, ly)
        local part = Instance.new("Part")
        part.Anchored = true; part.CanCollide = false; part.CastShadow = false
        part.Material = Enum.Material.Neon; part.Color = ly.color; part.Transparency = ly.tr
        part.Shape = shape; part.Size = size; part.CFrame = cf
        part.Parent = model
        if ly.pulse then pulsers[#pulsers + 1] = { part = part, base = ly.tr } end
    end
    local function bar(a, from, len, ly)
        local dir = Vector3.new(math.cos(a), math.sin(a), 0)
        mk(Enum.PartType.Block, Vector3.new(len, ly.thick, ly.thick),
            CFrame.new(from + dir * len / 2) * CFrame.Angles(0, 0, a), ly)
    end

    for _, ly in ipairs(layers) do
        for k = 0, 5 do
            local a = k * math.pi / 3
            local dir = Vector3.new(math.cos(a), math.sin(a), 0)
            bar(a, Vector3.new(), L, ly)
            for _, br in ipairs({ { 0.38, 3.2 }, { 0.68, 2.3 } }) do
                local base = dir * (L * br[1])
                bar(a + math.pi / 3, base, br[2], ly)
                bar(a - math.pi / 3, base, br[2], ly)
            end
            mk(Enum.PartType.Ball, Vector3.new(ly.thick * 3, ly.thick * 3, ly.thick * 3),
                CFrame.new(dir * L), ly)
        end
        mk(Enum.PartType.Ball, Vector3.new(ly.thick * 6, ly.thick * 6, ly.thick * 6), CFrame.new(), ly)
    end
    model.Parent = vf
    return model, pulsers
end

