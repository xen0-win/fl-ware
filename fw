local status = mk("TextLabel", {
    Position = UDim2.new(0, 12, 1, -26), Size = UDim2.new(1, -24, 0, 16), BackgroundTransparency = 1,
    Text = "", Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = C.mute,
    TextXAlignment = Enum.TextXAlignment.Left,
}, main)
