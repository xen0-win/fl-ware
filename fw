            -- ---------- Toggle ----------
            function Section:AddToggle(label, default, callback, flag)
                local state = default == true
                local row = new("Frame", {
                    Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = nextOrder(),
                }, inner)
                local lbl = text(row, {
                    Size = UDim2.new(1, -50, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Text = label,
                    TextColor3 = state and C.Frost or C.Text,
                })
                local track = new("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(40, 20), BackgroundColor3 = C.Bg0, BorderSizePixel = 0,
                }, row)
                round(track, 10)
                local trStroke = stroke(track, state and C.Ice or C.Line, 1, state and 0.2 or 0.4)
                local fill = new("Frame", {
                    Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Ice2,
                    BackgroundTransparency = state and 0 or 1, BorderSizePixel = 0,
                }, track)
                round(fill, 10)
                grad(fill, ICE_SEQ, 0)
                local knob = new("Frame", {
                    AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(14, 14),
                    Position = UDim2.new(0, state and 23 or 3, 0.5, 0),
                    BackgroundColor3 = C.Frost, BorderSizePixel = 0, ZIndex = 2,
                }, track)
                round(knob, 7)
                local knobGlow = stroke(knob, C.Ice, 3, state and 0.6 or 1)

                local hit = new("TextButton", {
                    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 3,
                }, row)

                local function render(animate)
                    local d = animate and 0.22 or 0
                    tween(fill, d, { BackgroundTransparency = state and 0 or 1 })
                    tween(trStroke, d, { Color = state and C.Ice or C.Line, Transparency = state and 0.2 or 0.4 })
                    tween(knob, d, { Position = UDim2.new(0, state and 23 or 3, 0.5, 0) }, Enum.EasingStyle.Back)
                    tween(knobGlow, d, { Transparency = state and 0.6 or 1 })
                    tween(lbl, d, { TextColor3 = state and C.Frost or C.Text })
                end
                hit.MouseButton1Click:Connect(function()
                    state = not state
                    render(true)
                    if flag then Lib.Flags[flag] = state end
                    if callback then task.spawn(callback, state) end
                end)
                if flag then Lib.Flags[flag] = state end

                return {
                    Frame = row,
                    Set = function(_, v) state = v == true; render(true); if flag then Lib.Flags[flag] = state end end,
                    Get = function() return state end,
                }
            end

            -- ---------- Slider ----------
            function Section:AddSlider(label, min, max, default, callback, opts)
                opts = opts or {}
                local dec, suf = opts.Decimals or 0, opts.Suffix or ""
                local value = math.clamp(default or min, min, max)

                local row = new("Frame", {
                    Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, LayoutOrder = nextOrder(),
                }, inner)
                text(row, {
                    Size = UDim2.new(1, -70, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, Text = label,
                })
                local valLbl = text(row, {
                    AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(70, 16),
                    Font = F_BOLD, TextColor3 = C.Ice, TextXAlignment = Enum.TextXAlignment.Right,
                })
                local bar = new("Frame", {
                    Position = UDim2.fromOffset(0, 27), Size = UDim2.new(1, 0, 0, 6),
                    BackgroundColor3 = C.Bg0, BorderSizePixel = 0,
                }, row)
                round(bar, 3)
                stroke(bar, C.Line, 1, 0.6)
                local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Ice, BorderSizePixel = 0 }, bar)
                round(fill, 3)
                grad(fill, ICE_SEQ, 0)
                local knob = new("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
                    Size = UDim2.fromOffset(12, 12), Rotation = 45, BackgroundColor3 = C.Frost,
                    BorderSizePixel = 0, ZIndex = 2,
                }, bar)
                stroke(knob, C.Ice, 2, 0.35)
                local hit = new("TextButton", {
                    Position = UDim2.fromOffset(0, 14), Size = UDim2.new(1, 0, 0, 26),
                    BackgroundTransparency = 1, Text = "", ZIndex = 3,
                }, row)

                local function fmt(v)
                    local s = dec > 0 and string.format("%." .. dec .. "f", v) or tostring(math.floor(v + 0.5))
                    return s .. suf
                end
                local function setValue(v, fire)
                    v = math.clamp(v, min, max)
                    if dec == 0 then v = math.floor(v + 0.5) else v = tonumber(string.format("%." .. dec .. "f", v)) end
                    value = v
                    local a = (max == min) and 0 or (value - min) / (max - min)
                    fill.Size = UDim2.fromScale(a, 1)
                    knob.Position = UDim2.fromScale(a, 0.5)
                    valLbl.Text = fmt(value)
                    if fire and callback then task.spawn(callback, value) end
                end
                setValue(value, false)

                local dragging = false
                local function fromX(x)
                    local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
                    setValue(min + (max - min) * a, true)
                end
                hit.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        tween(knob, 0.15, { Size = UDim2.fromOffset(16, 16) }, Enum.EasingStyle.Back)
                        fromX(i.Position.X)
                    end
                end)
                conn(UserInputService.InputChanged, function(i)
                    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                        fromX(i.Position.X)
                    end
                end)
                conn(UserInputService.InputEnded, function(i)
                    if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
                        dragging = false
                        tween(knob, 0.2, { Size = UDim2.fromOffset(12, 12) }, Enum.EasingStyle.Back)
                    end
                end)

                return {
                    Frame = row,
                    Set = function(_, v) setValue(v, false) end,
                    Get = function() return value end,
                }
            end

