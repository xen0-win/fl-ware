            task.defer(function() pcall(applyPackToObject, obj) end)
        end)
    else
        for obj, props in pairs(packOriginal) do
            if obj and obj.Parent then
                for prop, orig in pairs(props) do pcall(function() obj[prop] = orig end) end
            end
        end
