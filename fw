local function applyData(data)
    if type(data) ~= "table" then return false end
    local function b(k, d) if data[k] == nil then return d end return data[k] == true end
    local function n(k, d, lo, hi) return math.clamp(tonumber(data[k]) or d, lo, hi) end
    Cfg.HitEnabled  = b("HitEnabled", true)
    Cfg.HitSoundId  = tostring(data.HitSoundId or "")
    Cfg.HitVolume   = n("HitVolume", 3, 0, 10)
    Cfg.KillEnabled = b("KillEnabled", true)
    Cfg.KillSoundId = tostring(data.KillSoundId or "")
    Cfg.KillVolume  = n("KillVolume", 4, 0, 10)
    Cfg.NoTextures  = b("NoTextures", false)
    Cfg.UIPack      = b("UIPack", false)
    Cfg.Theme       = (Lib.Themes[data.Theme] and data.Theme) or "Frozen"
    Cfg.Flake3D     = b("Flake3D", true)
    Cfg.FlakeSize   = n("FlakeSize", 55, 20, 120)
    Cfg.Brightness  = n("Brightness", 0, 0, 100)
    Cfg.AutoLoad    = b("AutoLoad", true)
    Cfg.SkyOn       = b("SkyOn", false)
    Cfg.SkyStyle    = (SKY_COLORS[data.SkyStyle] and data.SkyStyle) or "Gray Sky"
    Cfg.LoadSoundEnabled = b("LoadSoundEnabled", true)
    Cfg.LoadSoundId      = tostring(data.LoadSoundId or "")
    Cfg.LoadSoundVolume  = n("LoadSoundVolume", 1, 0, 10)
    Cfg.TeleportLoad     = b("TeleportLoad", false)
    Cfg.AutoLoadUrl = (type(data.AutoLoadUrl) == "string" and data.AutoLoadUrl ~= "") and data.AutoLoadUrl or AUTO_LOAD_URL
    Cfg.WingOn      = b("WingOn", false)
    local wc = data.WingColor
    if type(wc) == "table" then
        Cfg.WingColor = {
            math.clamp(math.floor(tonumber(wc[1]) or 133), 0, 255),
            math.clamp(math.floor(tonumber(wc[2]) or 220), 0, 255),
            math.clamp(math.floor(tonumber(wc[3]) or 255), 0, 255),
        }
    else
        Cfg.WingColor = { 133, 220, 255 }
    end
    Cfg.WingRainbow = b("WingRainbow", false)
    Cfg.WingSpeed   = n("WingSpeed", 1, 0.1, 3)
    return true
end

